{
  // Compiles the printer code and its tests for plain Node (`npm run test:printer`). Only type imports reach the
  // React side (components/Receipt.tsx, lib/i18n.ts), so nothing outside lib/printer and lib/types runs.
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,
    "jsx": "react-jsx",
    "rootDir": ".",
    "outDir": ".test-build",
    "paths": { "@/*": ["./*"] }
  },
  "files": ["lib/printer/printer.test.ts", "lib/printer/desktop.test.ts"]
}
